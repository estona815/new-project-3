desc:Codex V20 Channel Polish
//tags: equalizer compressor saturation utility
//author: Codex

slider1:80<20,260,1>Highpass (Hz)
slider2:120<40,320,1>Low Shelf Freq (Hz)
slider3:0<-6,6,0.1>Low Shelf Gain (dB)
slider4:280<120,900,1>Mud Freq (Hz)
slider5:0<-9,6,0.1>Mud Gain (dB)
slider6:0.85<0.2,4,0.01>Mud Q
slider7:3200<900,8000,1>Presence Freq (Hz)
slider8:0<-6,6,0.1>Presence Gain (dB)
slider9:0.95<0.2,5,0.01>Presence Q
slider10:10500<4000,18000,1>Air Shelf Freq (Hz)
slider11:0<-6,6,0.1>Air Shelf Gain (dB)
slider12:-24<-60,0,0.1>Comp Threshold (dB)
slider13:1.4<1,8,0.05>Comp Ratio
slider14:20<1,120,0.1>Comp Attack (ms)
slider15:160<10,900,1>Comp Release (ms)
slider16:0<-12,12,0.1>Comp Makeup (dB)
slider17:0<0,12,0.1>Saturation Drive (dB)
slider18:0<0,1,0.01>Saturation Mix
slider19:1<0,1.6,0.01>Stereo Width
slider20:0<-18,18,0.1>Output Trim (dB)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_tail_size = -1;
db2lin = 0.1151292546497023;
lin2db = 8.685889638065037;
tiny = 0.000000000001;
comp_gain = 1;

hp_z1l = hp_z2l = hp_z1r = hp_z2r = 0;
ls_z1l = ls_z2l = ls_z1r = ls_z2r = 0;
mud_z1l = mud_z2l = mud_z1r = mud_z2r = 0;
pre_z1l = pre_z2l = pre_z1r = pre_z2r = 0;
air_z1l = air_z2l = air_z1r = air_z2r = 0;

@slider
hp_freq = min(max(slider1, 20), srate * 0.45);
ls_freq = min(max(slider2, 20), srate * 0.45);
mud_freq = min(max(slider4, 20), srate * 0.45);
pre_freq = min(max(slider7, 20), srate * 0.45);
air_freq = min(max(slider10, 20), srate * 0.45);

// Highpass.
w0 = 2 * $pi * hp_freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * 0.707);
b0 = (1 + cosw) * 0.5;
b1 = -(1 + cosw);
b2 = (1 + cosw) * 0.5;
a0 = 1 + alpha;
a1 = -2 * cosw;
a2 = 1 - alpha;
hp_b0 = b0 / a0; hp_b1 = b1 / a0; hp_b2 = b2 / a0;
hp_a1 = a1 / a0; hp_a2 = a2 / a0;

// Low shelf.
A = exp(slider3 * db2lin * 0.5);
w0 = 2 * $pi * ls_freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * 0.707);
sqrtA = sqrt(A);
b0 = A * ((A + 1) - (A - 1) * cosw + 2 * sqrtA * alpha);
b1 = 2 * A * ((A - 1) - (A + 1) * cosw);
b2 = A * ((A + 1) - (A - 1) * cosw - 2 * sqrtA * alpha);
a0 = (A + 1) + (A - 1) * cosw + 2 * sqrtA * alpha;
a1 = -2 * ((A - 1) + (A + 1) * cosw);
a2 = (A + 1) + (A - 1) * cosw - 2 * sqrtA * alpha;
ls_b0 = b0 / a0; ls_b1 = b1 / a0; ls_b2 = b2 / a0;
ls_a1 = a1 / a0; ls_a2 = a2 / a0;

// Mud peak.
A = exp(slider5 * db2lin * 0.5);
w0 = 2 * $pi * mud_freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * max(slider6, 0.05));
b0 = 1 + alpha * A;
b1 = -2 * cosw;
b2 = 1 - alpha * A;
a0 = 1 + alpha / A;
a1 = -2 * cosw;
a2 = 1 - alpha / A;
mud_b0 = b0 / a0; mud_b1 = b1 / a0; mud_b2 = b2 / a0;
mud_a1 = a1 / a0; mud_a2 = a2 / a0;

// Presence peak.
A = exp(slider8 * db2lin * 0.5);
w0 = 2 * $pi * pre_freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * max(slider9, 0.05));
b0 = 1 + alpha * A;
b1 = -2 * cosw;
b2 = 1 - alpha * A;
a0 = 1 + alpha / A;
a1 = -2 * cosw;
a2 = 1 - alpha / A;
pre_b0 = b0 / a0; pre_b1 = b1 / a0; pre_b2 = b2 / a0;
pre_a1 = a1 / a0; pre_a2 = a2 / a0;

// Air shelf.
A = exp(slider11 * db2lin * 0.5);
w0 = 2 * $pi * air_freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * 0.707);
sqrtA = sqrt(A);
b0 = A * ((A + 1) + (A - 1) * cosw + 2 * sqrtA * alpha);
b1 = -2 * A * ((A - 1) + (A + 1) * cosw);
b2 = A * ((A + 1) + (A - 1) * cosw - 2 * sqrtA * alpha);
a0 = (A + 1) - (A - 1) * cosw + 2 * sqrtA * alpha;
a1 = 2 * ((A - 1) - (A + 1) * cosw);
a2 = (A + 1) - (A - 1) * cosw - 2 * sqrtA * alpha;
air_b0 = b0 / a0; air_b1 = b1 / a0; air_b2 = b2 / a0;
air_a1 = a1 / a0; air_a2 = a2 / a0;

thresh_db = slider12;
ratio = max(slider13, 1);
att = exp(-1 / (max(slider14, 0.1) * 0.001 * srate));
rel = exp(-1 / (max(slider15, 1) * 0.001 * srate));
makeup = exp(slider16 * db2lin);
drive = exp(slider17 * db2lin);
sat_mix = min(max(slider18, 0), 1);
width = slider19;
out_gain = exp(slider20 * db2lin);

@sample
l = spl0;
r = spl1;

// Highpass.
y = hp_b0 * l + hp_z1l; hp_z1l = hp_b1 * l - hp_a1 * y + hp_z2l; hp_z2l = hp_b2 * l - hp_a2 * y; l = y;
y = hp_b0 * r + hp_z1r; hp_z1r = hp_b1 * r - hp_a1 * y + hp_z2r; hp_z2r = hp_b2 * r - hp_a2 * y; r = y;

// Low shelf.
y = ls_b0 * l + ls_z1l; ls_z1l = ls_b1 * l - ls_a1 * y + ls_z2l; ls_z2l = ls_b2 * l - ls_a2 * y; l = y;
y = ls_b0 * r + ls_z1r; ls_z1r = ls_b1 * r - ls_a1 * y + ls_z2r; ls_z2r = ls_b2 * r - ls_a2 * y; r = y;

// Mud peak.
y = mud_b0 * l + mud_z1l; mud_z1l = mud_b1 * l - mud_a1 * y + mud_z2l; mud_z2l = mud_b2 * l - mud_a2 * y; l = y;
y = mud_b0 * r + mud_z1r; mud_z1r = mud_b1 * r - mud_a1 * y + mud_z2r; mud_z2r = mud_b2 * r - mud_a2 * y; r = y;

// Presence peak.
y = pre_b0 * l + pre_z1l; pre_z1l = pre_b1 * l - pre_a1 * y + pre_z2l; pre_z2l = pre_b2 * l - pre_a2 * y; l = y;
y = pre_b0 * r + pre_z1r; pre_z1r = pre_b1 * r - pre_a1 * y + pre_z2r; pre_z2r = pre_b2 * r - pre_a2 * y; r = y;

// Air shelf.
y = air_b0 * l + air_z1l; air_z1l = air_b1 * l - air_a1 * y + air_z2l; air_z2l = air_b2 * l - air_a2 * y; l = y;
y = air_b0 * r + air_z1r; air_z1r = air_b1 * r - air_a1 * y + air_z2r; air_z2r = air_b2 * r - air_a2 * y; r = y;

det = max(abs(l), abs(r));
det_db = lin2db * log(max(det, tiny));
over_db = max(det_db - thresh_db, 0);
gr_db = -over_db * (1 - 1 / ratio);
target_gain = exp(gr_db * db2lin) * makeup;
target_gain < comp_gain ? comp_gain = target_gain + att * (comp_gain - target_gain) : comp_gain = target_gain + rel * (comp_gain - target_gain);
l *= comp_gain;
r *= comp_gain;

drive > 1.0001 || sat_mix > 0.0001 ? (
  norm = max(tanh(drive), tiny);
  sl = tanh(l * drive) / norm;
  sr = tanh(r * drive) / norm;
  l = l * (1 - sat_mix) + sl * sat_mix;
  r = r * (1 - sat_mix) + sr * sat_mix;
);

mid = (l + r) * 0.5;
side = (l - r) * 0.5 * width;
spl0 = (mid + side) * out_gain;
spl1 = (mid - side) * out_gain;
