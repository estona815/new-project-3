desc:Codex Dynamic EQ Band
//tags: dynamics equalizer dynamic-eq
//author: Codex

slider1:350<80,12000,1>Frequency (Hz)
slider2:1.20<0.2,8,0.01>Q
slider3:-28<-60,0,0.1>Threshold (dB)
slider4:3<0,12,0.1>Max Cut (dB)
slider5:8<1,80,0.1>Attack (ms)
slider6:140<10,900,1>Release (ms)
slider7:0<0,1,1>Audition Band Only

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_tail_size = -1;
db2lin = 0.1151292546497023;
lin2db = 8.685889638065037;
tiny = 0.000000000001;
z1l = z2l = z1r = z2r = 0;
env = 0;

@slider
freq = min(max(slider1, 20), srate * 0.45);
q = max(slider2, 0.05);
thresh_db = slider3;
max_cut_db = slider4;
attack_ms = max(slider5, 0.1);
release_ms = max(slider6, 1);
audition = slider7;

w0 = 2 * $pi * freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * q);

b0 = alpha;
b1 = 0;
b2 = -alpha;
a0 = 1 + alpha;
a1 = -2 * cosw;
a2 = 1 - alpha;

bb0 = b0 / a0;
bb1 = b1 / a0;
bb2 = b2 / a0;
aa1 = a1 / a0;
aa2 = a2 / a0;

att = exp(-1 / (attack_ms * 0.001 * srate));
rel = exp(-1 / (release_ms * 0.001 * srate));

@sample
inl = spl0;
inr = spl1;

bpl = bb0 * inl + z1l;
z1l = bb1 * inl - aa1 * bpl + z2l;
z2l = bb2 * inl - aa2 * bpl;

bpr = bb0 * inr + z1r;
z1r = bb1 * inr - aa1 * bpr + z2r;
z2r = bb2 * inr - aa2 * bpr;

det = max(abs(bpl), abs(bpr));
det > env ? env = det + att * (env - det) : env = det + rel * (env - det);
env_db = lin2db * log(max(env, tiny));
over = max(env_db - thresh_db, 0);
cut_db = min(max_cut_db, over * 0.65);
band_gain = exp(-cut_db * db2lin);

audition >= 0.5 ? (
  spl0 = bpl * band_gain;
  spl1 = bpr * band_gain;
) : (
  spl0 = inl + (band_gain - 1) * bpl;
  spl1 = inr + (band_gain - 1) * bpr;
);
