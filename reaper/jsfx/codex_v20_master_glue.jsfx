desc:Codex V20 Master Glue
//tags: mastering compressor softclip
//author: Codex

slider1:24<10,80,1>Sub Filter (Hz)
slider2:-0.5<-4,4,0.1>Low Tighten (dB)
slider3:95<45,180,1>Low Tighten Freq (Hz)
slider4:-0.3<-4,4,0.1>Low Mid Clean (dB)
slider5:320<140,700,1>Low Mid Freq (Hz)
slider6:-0.35<-4,4,0.1>Presence Smooth (dB)
slider7:3900<1500,7000,1>Presence Smooth Freq (Hz)
slider8:0.25<-3,3,0.1>Air Lift (dB)
slider9:11200<6000,18000,1>Air Lift Freq (Hz)
slider10:-18<-40,0,0.1>Glue Threshold (dB)
slider11:1.25<1,4,0.05>Glue Ratio
slider12:32<1,150,0.1>Glue Attack (ms)
slider13:180<20,900,1>Glue Release (ms)
slider14:0.8<-6,8,0.1>Glue Makeup (dB)
slider15:2.2<0,10,0.1>Soft Clip Drive (dB)
slider16:-1.0<-6,-0.1,0.1>Ceiling (dBFS)
slider17:0<-12,12,0.1>Output Trim (dB)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_tail_size = -1;
db2lin = 0.1151292546497023;
lin2db = 8.685889638065037;
tiny = 0.000000000001;
comp_gain = 1;
hp_z1l = hp_z2l = hp_z1r = hp_z2r = 0;
ls_z1l = ls_z2l = ls_z1r = ls_z2r = 0;
lm_z1l = lm_z2l = lm_z1r = lm_z2r = 0;
pr_z1l = pr_z2l = pr_z1r = pr_z2r = 0;
air_z1l = air_z2l = air_z1r = air_z2r = 0;

@slider
hp_freq = min(max(slider1, 10), srate * 0.45);
low_freq = min(max(slider3, 20), srate * 0.45);
lm_freq = min(max(slider5, 20), srate * 0.45);
pr_freq = min(max(slider7, 20), srate * 0.45);
air_freq = min(max(slider9, 20), srate * 0.45);

w0 = 2 * $pi * hp_freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * 0.707);
b0 = (1 + cosw) * 0.5;
b1 = -(1 + cosw);
b2 = (1 + cosw) * 0.5;
a0 = 1 + alpha;
a1 = -2 * cosw;
a2 = 1 - alpha;
hp_b0 = b0 / a0; hp_b1 = b1 / a0; hp_b2 = b2 / a0; hp_a1 = a1 / a0; hp_a2 = a2 / a0;

A = exp(slider2 * db2lin * 0.5);
w0 = 2 * $pi * low_freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * 0.707);
sqrtA = sqrt(A);
b0 = A * ((A + 1) - (A - 1) * cosw + 2 * sqrtA * alpha);
b1 = 2 * A * ((A - 1) - (A + 1) * cosw);
b2 = A * ((A + 1) - (A - 1) * cosw - 2 * sqrtA * alpha);
a0 = (A + 1) + (A - 1) * cosw + 2 * sqrtA * alpha;
a1 = -2 * ((A - 1) + (A + 1) * cosw);
a2 = (A + 1) + (A - 1) * cosw - 2 * sqrtA * alpha;
ls_b0 = b0 / a0; ls_b1 = b1 / a0; ls_b2 = b2 / a0; ls_a1 = a1 / a0; ls_a2 = a2 / a0;

A = exp(slider4 * db2lin * 0.5);
w0 = 2 * $pi * lm_freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * 0.95);
b0 = 1 + alpha * A; b1 = -2 * cosw; b2 = 1 - alpha * A;
a0 = 1 + alpha / A; a1 = -2 * cosw; a2 = 1 - alpha / A;
lm_b0 = b0 / a0; lm_b1 = b1 / a0; lm_b2 = b2 / a0; lm_a1 = a1 / a0; lm_a2 = a2 / a0;

A = exp(slider6 * db2lin * 0.5);
w0 = 2 * $pi * pr_freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * 1.0);
b0 = 1 + alpha * A; b1 = -2 * cosw; b2 = 1 - alpha * A;
a0 = 1 + alpha / A; a1 = -2 * cosw; a2 = 1 - alpha / A;
pr_b0 = b0 / a0; pr_b1 = b1 / a0; pr_b2 = b2 / a0; pr_a1 = a1 / a0; pr_a2 = a2 / a0;

A = exp(slider8 * db2lin * 0.5);
w0 = 2 * $pi * air_freq / srate;
cosw = cos(w0);
sinw = sin(w0);
alpha = sinw / (2 * 0.707);
sqrtA = sqrt(A);
b0 = A * ((A + 1) + (A - 1) * cosw + 2 * sqrtA * alpha);
b1 = -2 * A * ((A - 1) + (A + 1) * cosw);
b2 = A * ((A + 1) + (A - 1) * cosw - 2 * sqrtA * alpha);
a0 = (A + 1) - (A - 1) * cosw + 2 * sqrtA * alpha;
a1 = 2 * ((A - 1) - (A + 1) * cosw);
a2 = (A + 1) - (A - 1) * cosw - 2 * sqrtA * alpha;
air_b0 = b0 / a0; air_b1 = b1 / a0; air_b2 = b2 / a0; air_a1 = a1 / a0; air_a2 = a2 / a0;

thresh_db = slider10;
ratio = max(slider11, 1);
att = exp(-1 / (max(slider12, 0.1) * 0.001 * srate));
rel = exp(-1 / (max(slider13, 1) * 0.001 * srate));
makeup = exp(slider14 * db2lin);
drive = exp(slider15 * db2lin);
ceiling = exp(slider16 * db2lin);
out_gain = exp(slider17 * db2lin);

@sample
l = spl0;
r = spl1;

y = hp_b0 * l + hp_z1l; hp_z1l = hp_b1 * l - hp_a1 * y + hp_z2l; hp_z2l = hp_b2 * l - hp_a2 * y; l = y;
y = hp_b0 * r + hp_z1r; hp_z1r = hp_b1 * r - hp_a1 * y + hp_z2r; hp_z2r = hp_b2 * r - hp_a2 * y; r = y;

y = ls_b0 * l + ls_z1l; ls_z1l = ls_b1 * l - ls_a1 * y + ls_z2l; ls_z2l = ls_b2 * l - ls_a2 * y; l = y;
y = ls_b0 * r + ls_z1r; ls_z1r = ls_b1 * r - ls_a1 * y + ls_z2r; ls_z2r = ls_b2 * r - ls_a2 * y; r = y;

y = lm_b0 * l + lm_z1l; lm_z1l = lm_b1 * l - lm_a1 * y + lm_z2l; lm_z2l = lm_b2 * l - lm_a2 * y; l = y;
y = lm_b0 * r + lm_z1r; lm_z1r = lm_b1 * r - lm_a1 * y + lm_z2r; lm_z2r = lm_b2 * r - lm_a2 * y; r = y;

y = pr_b0 * l + pr_z1l; pr_z1l = pr_b1 * l - pr_a1 * y + pr_z2l; pr_z2l = pr_b2 * l - pr_a2 * y; l = y;
y = pr_b0 * r + pr_z1r; pr_z1r = pr_b1 * r - pr_a1 * y + pr_z2r; pr_z2r = pr_b2 * r - pr_a2 * y; r = y;

y = air_b0 * l + air_z1l; air_z1l = air_b1 * l - air_a1 * y + air_z2l; air_z2l = air_b2 * l - air_a2 * y; l = y;
y = air_b0 * r + air_z1r; air_z1r = air_b1 * r - air_a1 * y + air_z2r; air_z2r = air_b2 * r - air_a2 * y; r = y;

det = max(abs(l), abs(r));
det_db = lin2db * log(max(det, tiny));
over_db = max(det_db - thresh_db, 0);
gr_db = -over_db * (1 - 1 / ratio);
target_gain = exp(gr_db * db2lin) * makeup;
target_gain < comp_gain ? comp_gain = target_gain + att * (comp_gain - target_gain) : comp_gain = target_gain + rel * (comp_gain - target_gain);
l *= comp_gain;
r *= comp_gain;

l = ceiling * tanh((l * drive) / max(ceiling, tiny));
r = ceiling * tanh((r * drive) / max(ceiling, tiny));

spl0 = l * out_gain;
spl1 = r * out_gain;
