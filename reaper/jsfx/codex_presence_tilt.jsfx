desc:Codex Presence Tilt
//tags: equalizer presence melody tilt
//author: Codex

slider1:1600<300,8000,1>Split Frequency (Hz)
slider2:0.8<-3,3,0.1>Upper Band Gain (dB)
slider3:1<0,1,0.01>Mix

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
db2lin = 0.1151292546497023;
lp_l = 0;
lp_r = 0;
ext_tail_size = -1;

@slider
freq = min(max(slider1, 80), srate * 0.45);
lp_coef = exp(-2 * $pi * freq / srate);
gain = exp(slider2 * db2lin);
wet = min(max(slider3, 0), 1);

@sample
in_l = spl0;
in_r = spl1;

lp_l = lp_coef * lp_l + (1 - lp_coef) * in_l;
lp_r = lp_coef * lp_r + (1 - lp_coef) * in_r;
hi_l = in_l - lp_l;
hi_r = in_r - lp_r;

out_l = in_l + hi_l * (gain - 1);
out_r = in_r + hi_r * (gain - 1);

spl0 = in_l + (out_l - in_l) * wet;
spl1 = in_r + (out_r - in_r) * wet;
