    "pitch_correction",
    "static_eq",
    "dynamic_eq",
    "resonance_suppressor",
    "compressor",
    "limiter",
    "saturator",
    "multiband_compressor",
    "deesser",
    "reverb",
    "delay",
    "stereo_width",
    "noise_reduction",
    "analyzer",
    "utility"
