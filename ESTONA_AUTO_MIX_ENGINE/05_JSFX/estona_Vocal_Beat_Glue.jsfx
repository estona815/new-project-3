desc:estona_Vocal_Beat_Glue
// Purpose: Gentle bus glue to reduce the feeling that vocal and beat are separate.
// Use: vocal+beat group, premaster draft bus, or parallel glue bus.
// Defaults: glue 35%, attack 20 ms, release 160 ms, mix 60%.
// Overuse risk: pumping, buried vocal, flattened beat movement.

slider1:glue=0.35<0,1,0.01>Glue amount
slider2:attack_ms=20<1,100,1>Attack (ms)
slider3:release_ms=160<20,800,1>Release (ms)
slider4:saturation=0.2<0,1,0.01>Light saturation
slider5:mix=0.6<0,1,0.01>Mix
slider6:out_db=0<-12,12,0.1>Output trim (dB)
slider7:bypass=0<0,1,1>Bypass

@init
env = 0;

@slider
atk = exp(-1/(srate*attack_ms/1000));
rel = exp(-1/(srate*release_ms/1000));
out = 10^(out_db/20);

@sample
dry0 = spl0; dry1 = spl1;
bypass < 0.5 ? (
  level = max(abs(dry0), abs(dry1));
  env = level > env ? env*atk + level*(1-atk) : env*rel + level*(1-rel);
  gr = 1 / (1 + max(0, env - 0.25) * glue * 2.2);
  sat0 = tanh(dry0 * (1 + saturation * 2)) / (1 + saturation * 0.8);
  sat1 = tanh(dry1 * (1 + saturation * 2)) / (1 + saturation * 0.8);
  wet0 = sat0 * gr;
  wet1 = sat1 * gr;
  spl0 = (dry0*(1-mix) + wet0*mix) * out;
  spl1 = (dry1*(1-mix) + wet1*mix) * out;
);
