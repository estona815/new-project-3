desc:estona_MonoSub_Guard
// Purpose: Keep 808/sub low end mono-compatible.
// Use: bass/808 bus, premaster, or print bus before final clipping.
// Defaults: crossover 120 Hz, mono amount 85%, side-low reduction 80%.
// Overuse risk: narrowed mix, reduced width in low toms or stereo synth bass.

slider1:crossover_hz=120<40,220,1>Crossover frequency
slider2:mono_amount=0.85<0,1,0.01>Below crossover mono control
slider3:side_low_reduction=0.8<0,1,0.01>Side low reduction
slider4:mono_audition=0<0,1,1>Mono audition
slider5:out_db=0<-12,12,0.1>Output trim (dB)
slider6:bypass=0<0,1,1>Bypass

@init
ll = lr = 0; corr_warn = 0;

@slider
a = min(0.99, max(0.001, 2*$pi*crossover_hz/srate));
out = 10^(out_db/20);

@sample
dry0 = spl0; dry1 = spl1;
bypass < 0.5 ? (
  ll += a * (dry0 - ll);
  lr += a * (dry1 - lr);
  low_mid = (ll + lr) * 0.5;
  low_side_l = ll - low_mid;
  low_side_r = lr - low_mid;
  new_low_l = ll*(1-mono_amount) + (low_mid + low_side_l*(1-side_low_reduction))*mono_amount;
  new_low_r = lr*(1-mono_amount) + (low_mid + low_side_r*(1-side_low_reduction))*mono_amount;
  hi0 = dry0 - ll; hi1 = dry1 - lr;
  wet0 = hi0 + new_low_l;
  wet1 = hi1 + new_low_r;
  mono_audition > 0.5 ? (
    m = (wet0 + wet1) * 0.5; wet0 = m; wet1 = m;
  );
  corr_warn = abs(low_side_l) + abs(low_side_r) > abs(low_mid) * 0.8 ? 1 : corr_warn * 0.999;
  spl0 = wet0 * out;
  spl1 = wet1 * out;
);

@gfx 360 70
gfx_set(0.1,0.1,0.1,1); gfx_rect(0,0,gfx_w,gfx_h,1);
gfx_set(corr_warn > 0.2 ? 1 : 0.25, corr_warn > 0.2 ? 0.25 : 0.85, 0.25, 1);
gfx_rect(10,28,(gfx_w-20)*min(1,corr_warn),14,1);
gfx_set(0.85,0.85,0.85,1); gfx_x=10; gfx_y=10; gfx_drawstr("ESTONA MonoSub side-low warning");
