desc:estona_DigiClip
// Purpose: Digicore/hyperpop soft clipper for controlled loudness.
// Use: drum bus, beat bus, or master print bus after gain staging.
// Defaults: drive 1.5 dB, clip 0.65, knee 0.35, ceiling -1.0 dB, mix 100%.
// Overuse risk: flat transientless master, splashy cymbals, harsh vocal consonants.

slider1:drive_db=1.5<-12,18,0.1>Input drive (dB)
slider2:clip_amount=0.65<0,1,0.01>Clip amount
slider3:knee=0.35<0.01,1,0.01>Knee
slider4:ceiling_db=-1<-12,0,0.1>Ceiling (dB)
slider5:out_db=0<-12,12,0.1>Output trim (dB)
slider6:mix=1<0,1,0.01>Mix
slider7:bypass=0<0,1,1>Bypass

@init
meter_clip = 0;
smooth_gain = 1;

@slider
drive = 10^(drive_db/20);
ceiling = 10^(ceiling_db/20);
out = 10^(out_db/20);

@sample
dry0 = spl0; dry1 = spl1;
bypass < 0.5 ? (
  x0 = spl0 * drive;
  x1 = spl1 * drive;
  shaped0 = tanh(x0 / max(knee, 0.001)) * knee;
  shaped1 = tanh(x1 / max(knee, 0.001)) * knee;
  hard0 = max(-ceiling, min(ceiling, shaped0));
  hard1 = max(-ceiling, min(ceiling, shaped1));
  wet0 = x0 * (1 - clip_amount) + hard0 * clip_amount;
  wet1 = x1 * (1 - clip_amount) + hard1 * clip_amount;
  meter_clip = max(meter_clip * 0.999, max(abs(x0 - wet0), abs(x1 - wet1)));
  spl0 = (dry0 * (1 - mix) + wet0 * mix) * out;
  spl1 = (dry1 * (1 - mix) + wet1 * mix) * out;
);

@gfx 360 70
gfx_set(0.12,0.12,0.12,1); gfx_rect(0,0,gfx_w,gfx_h,1);
gfx_set(0.9,0.55,0.2,1);
bar = min(1, meter_clip * 8);
gfx_rect(10,28,(gfx_w-20)*bar,14,1);
gfx_set(0.85,0.85,0.85,1); gfx_x=10; gfx_y=10; gfx_drawstr("ESTONA DigiClip clipping meter");
