{
  "schema": "codex-vocal-factory-presets-v1",
  "plugin": "Codex Vocal AI Artifact Split Tamer",
  "format": "REAPER JSFX",
  "philosophy": "Source-preserving AI artifact and noise suppression. The product is not a maximum noise-removal tool; clean but damaged audio is a failed result.",
  "default_preset": "Preserve",
  "fresh_instance_policy": {
    "preset": "Preserve",
    "strong_mode_default_allowed": false,
    "residual_monitor_default": "Off",
    "dry_wet_default_percent": 70,
    "amount_default_percent": 30,
    "max_suppression_db_default": 8.0,
    "mask_strength_default": 0.35
  },
  "legacy_preset_policy": {
    "load_old_presets": true,
    "missing_new_parameters": "use_safe_defaults",
    "invalid_values": "clamp_to_absolute_range",
    "strong_mode_auto_migration": false,
    "notes": "Existing JSFX slider order is preserved. Sliders added after slider8 get safe defaults when absent."
  },
  "parameter_definitions": {
    "slider1": {"id": "AttackHarshTame", "label": "Attack Harsh Tame", "min": 0.0, "max": 100.0, "default": 32.0, "ui_group": "developer"},
    "slider2": {"id": "SandySibilanceTame", "label": "Sandy Sibilance Tame", "min": 0.0, "max": 100.0, "default": 38.0, "ui_group": "developer"},
    "slider3": {"id": "DigitalFizzTame", "label": "Digital Fizz Tame", "min": 0.0, "max": 100.0, "default": 44.0, "ui_group": "developer"},
    "slider4": {"id": "TailWarbleHide", "label": "Tail Warble Hide", "min": 0.0, "max": 100.0, "default": 28.0, "ui_group": "developer"},
    "slider5": {"id": "BodyPreserve", "label": "Body Preserve", "min": 0.0, "max": 100.0, "default": 20.0, "ui_group": "advanced"},
    "slider6": {"id": "DryWet", "label": "Dry/Wet", "user_label": "Dry/Wet blend", "min": 0.0, "max": 100.0, "default": 70.0, "ui_group": "main"},
    "slider7": {"id": "OutputTrimDb", "label": "Output Trim (dB)", "min": -18.0, "max": 18.0, "default": 0.0, "ui_group": "advanced"},
    "slider8": {"id": "Bypass", "label": "Bypass", "min": 0.0, "max": 1.0, "default": 0.0, "ui_group": "main"},
    "slider9": {"id": "Amount", "label": "Amount", "user_label": "Overall cleanup strength", "min": 0.0, "max": 100.0, "default": 30.0, "ui_group": "main", "mapping": "pow(userAmount, 1.6)"},
    "slider10": {"id": "MaxSuppressionDb", "label": "Max Reduction (dB)", "min": 0.0, "max": 24.0, "default": 8.0, "ui_group": "advanced"},
    "slider11": {"id": "AttackMs", "label": "Detector Attack (ms)", "min": 1.0, "max": 200.0, "default": 50.0, "ui_group": "advanced"},
    "slider12": {"id": "ReleaseMs", "label": "Detector Release (ms)", "min": 1.0, "max": 500.0, "default": 12.0, "ui_group": "advanced"},
    "slider13": {"id": "ProcessingEnabled", "label": "Processing Enabled", "min": 0.0, "max": 1.0, "default": 1.0, "ui_group": "developer"},
    "slider14": {"id": "MaskStrength", "label": "Mask Strength", "min": 0.0, "max": 1.0, "default": 0.35, "ui_group": "developer"},
    "slider15": {"id": "SoftKneeDb", "label": "Soft Knee (dB)", "min": 1.0, "max": 24.0, "default": 9.0, "ui_group": "developer"},
    "slider16": {"id": "VocalPreserve", "label": "Vocal Preserve", "user_label": "Protects vocal body and presence", "min": 0.0, "max": 1.0, "default": 0.85, "ui_group": "main"},
    "slider17": {"id": "ClarityPreserve", "label": "Clarity Preserve", "user_label": "Protects consonants and forward detail", "min": 0.0, "max": 1.0, "default": 0.85, "ui_group": "main"},
    "slider18": {"id": "AirPreserve", "label": "Air Preserve", "user_label": "Protects high-frequency air and ambience", "min": 0.0, "max": 1.0, "default": 0.80, "ui_group": "main"},
    "slider19": {"id": "TransientPreserve", "label": "Transient Preserve", "min": 0.0, "max": 1.0, "default": 0.80, "ui_group": "advanced"},
    "slider20": {"id": "MultibandEnabled", "label": "Multiband Enabled", "min": 0.0, "max": 1.0, "default": 1.0, "ui_group": "advanced"},
    "slider21": {"id": "MSEnabled", "label": "M/S Enabled", "min": 0.0, "max": 1.0, "default": 1.0, "ui_group": "advanced"},
    "slider22": {"id": "MultibandMode", "label": "Multiband Mode", "min": 0.0, "max": 3.0, "default": 0.0, "ui_group": "main", "enum": ["Preserve", "Balanced", "Surgical AI", "Strong Test"]},
    "slider23": {"id": "MidAmount", "label": "Mid Amount", "min": 0.0, "max": 1.0, "default": 0.25, "ui_group": "advanced"},
    "slider24": {"id": "SideAmount", "label": "Side Amount", "min": 0.0, "max": 1.0, "default": 0.40, "ui_group": "advanced"},
    "slider25": {"id": "SideArtifactReduction", "label": "Side Artifact Reduction", "user_label": "Reduces stereo-side noise while preserving center vocal", "min": 0.0, "max": 1.0, "default": 0.45, "ui_group": "advanced"},
    "slider26": {"id": "SurgicalArtifactReduction", "label": "Surgical Artifact Reduction", "user_label": "Targets metallic AI artifacts and narrow chirps", "min": 0.0, "max": 1.0, "default": 0.25, "ui_group": "main"},
    "slider27": {"id": "ResidualMonitor", "label": "Residual Monitor", "user_label": "Listen to what is being removed", "min": 0.0, "max": 2.0, "default": 0.0, "ui_group": "main", "enum": ["Off", "Processed", "Residual"]},
    "slider28": {"id": "MidPreserve", "label": "Mid Preserve", "min": 0.0, "max": 1.0, "default": 0.85, "ui_group": "advanced"},
    "internal_harmonic_preserve": {"id": "HarmonicPreserve", "label": "Harmonic Preserve", "min": 0.0, "max": 1.0, "default": 0.75, "ui_group": "internal"}
  },
