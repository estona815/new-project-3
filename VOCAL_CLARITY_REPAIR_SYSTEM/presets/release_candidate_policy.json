  "release_blockers": [
    "plugin_crash",
    "nan_inf_reaches_output",
    "invalid_model_output_reaches_audio",
    "bypass_not_dry",
    "drywet_zero_not_dry",
    "clean_vocal_damaged_in_preserve",
    "preserve_obvious_dullness",
    "default_residual_contains_strong_ghost_vocal",
    "default_transient_smear",
    "default_presence_loss_over_threshold",
    "default_air_collapse",
    "stereo_image_collapse",
    "strong_mode_default_or_auto_selected",
    "obvious_realtime_unsafe_audio_thread_work",
    "severe_mode_switch_clicks",
    "model_not_ready_outputs_silence_or_broken_audio",
    "preset_loading_breaks_existing_sessions"
  ],
  "release_warnings": [
    "Balanced mode slightly darkens some sources",
    "Surgical mode helps only certain AI artifacts",
    "Strong mode damages some clean material",
    "Model confidence often falls back to DSP Only",
    "ReaFIR-like micro suppression was not ported",
    "Residual monitor unavailable in some formats",
    "CPU high in Surgical mode",
    "Sample rate 96 kHz uses reduced band count if needed",
    "Unsupported channel layouts fall back to stereo or mono safe path"
  ],
  "required_prompt_tests": [
    "Prompt 1 safety tests",
    "Prompt 2 soft mask tests",
    "Prompt 3 preservation tests",
    "Prompt 5 multiband/M/S tests",
    "Prompt 6 model output tests",
    "Prompt 7 evaluation harness tests",
    "Prompt 8 preset gate tests"
  ],
  "manual_listening_required": true,
  "approval_rule": "A preset cannot pass if vocal preservation or residual cleanliness is rated below acceptable threshold.",
  "residual_policy": {
    "good_residual": ["noise", "hiss", "hum", "AI chirp", "metallic artifact", "unwanted fuzz"],
    "bad_residual": ["vocal phrases", "S/T/CH consonants", "musical breath", "harmonic overtones", "guitar picking", "snare attack", "source ambience tail"],
    "action_if_bad": "reduce processing, raise preserve controls, reduce high-band attenuation, or reject preset"
  },
  "automation_safety": {
    "continuous_parameters_to_smooth": ["Amount", "DryWet", "MaxSuppressionDb", "VocalPreserve", "ClarityPreserve", "AirPreserve", "TransientPreserve", "SideArtifactReduction", "SurgicalArtifactReduction"],
    "mode_parameters": ["MultibandMode", "MSEnabled", "MultibandEnabled", "ResidualMonitor"],
    "rules": [
      "Do not allocate while responding to automation.",
      "Continuous parameters must change through smoothed gain paths.",
      "Mode changes must not bypass dry fallback, NaN/Inf checks, or total attenuation budgets.",
      "FFT size, hop size, and band count are not exposed as real-time release controls.",
      "Residual monitor is a listening/debug output and must not alter bypass safety."
    ]
  },
  "mode_switching_safety": {
    "rules": [
      "Fresh mode is Preserve.",
      "Strong is never selected by migration.",
      "Switching modes must retain dry/wet alignment.",
      "Gain changes should settle through existing detector and wet smoothing.",
      "If a future model mode is not ready, output must fall back to dry or DSP-only safe path."
    ]
  },
  "report_fields": [
    "preset",
    "parameter_values",
    "mode",
    "band_count",
    "ms_state",
    "model_mode",
    "average_noise_reduction",
    "average_source_preservation",
    "worst_case_source_preservation",
    "average_clarity_score",
    "worst_case_clarity_score",
    "average_air_score",
    "worst_case_air_score",
    "residual_leakage_score",
    "failure_tags",
    "recommended_use",
    "not_recommended_use"
  ]
}
